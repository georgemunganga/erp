-- M7A quotation role grants: explicit reviewed release step, never startup DDL.
-- psql -X -v ON_ERROR_STOP=1 -v expected_database=... -v expected_system_identifier=... -f this-file
-- Apply only after the verified M6 role correction and genuine M7A migration.
-- Caller must pin initial ACLs and reconcile the exact complete after-state.
\set ON_ERROR_STOP on
\if :{?expected_database}
\else
DO $required_database$ BEGIN
  RAISE EXCEPTION 'expected_database is required' USING ERRCODE='22023';
END $required_database$;
\endif
\if :{?expected_system_identifier}
\else
DO $required_cluster$ BEGIN
  RAISE EXCEPTION 'expected_system_identifier is required' USING ERRCODE='22023';
END $required_cluster$;
\endif
BEGIN;
SET LOCAL lock_timeout = '3s';
SET LOCAL statement_timeout = '30s';
SELECT pg_catalog.set_config('greenwebb.expected_database', :'expected_database', true);
SELECT pg_catalog.set_config('greenwebb.expected_system_identifier', :'expected_system_identifier', true);
DO $m7_quotation_preflight$
BEGIN
  IF current_user <> session_user OR current_user <> 'erp'
    OR pg_catalog.current_database() <> pg_catalog.current_setting('greenwebb.expected_database')
    OR (SELECT system_identifier::text FROM pg_catalog.pg_control_system())
       <> pg_catalog.current_setting('greenwebb.expected_system_identifier') THEN
    RAISE EXCEPTION 'Reviewed database owner and exact cluster are required' USING ERRCODE='55000';
  END IF;
  IF NOT EXISTS (SELECT 1 FROM procurement.__procurement_migrations
    WHERE "MigrationId"='20261030145538_M7aPrincipalManualQuotations')
    OR NOT EXISTS (SELECT 1 FROM hrm.__hrm_migrations
    WHERE "MigrationId"='20261030035815_M6dCoreCurrencyPrecision') THEN
    RAISE EXCEPTION 'Apply the reviewed genuine Core and Procurement migrations first' USING ERRCODE='55000';
  END IF;
  IF (SELECT count(*) FROM pg_catalog.pg_roles WHERE rolname IN
    ('erp_core_api_finite_v1','erp_proc_record_finite_v1','erp_proc_execute_finite_v1')) <> 3
    OR EXISTS (SELECT 1 FROM pg_catalog.pg_roles WHERE rolname IN
    ('erp_core_api_finite_v1','erp_proc_record_finite_v1','erp_proc_execute_finite_v1')
    AND (rolsuper OR rolcreatedb OR rolcreaterole OR rolreplication OR rolbypassrls)) THEN
    RAISE EXCEPTION 'The existing limited application roles are required' USING ERRCODE='55000';
  END IF;
END
$m7_quotation_preflight$;

GRANT SELECT, INSERT ON TABLE procurement.sourcing_manual_contacts TO erp_proc_execute_finite_v1;
REVOKE SELECT, INSERT, UPDATE, DELETE ON TABLE procurement.sourcing_manual_contacts FROM procurement_api;
GRANT SELECT, INSERT ON TABLE procurement.sourcing_manual_quote_versions TO erp_proc_execute_finite_v1;
REVOKE SELECT, INSERT, UPDATE, DELETE ON TABLE procurement.sourcing_manual_quote_versions FROM procurement_api;
GRANT SELECT, INSERT, UPDATE ON TABLE procurement.supplier_bids TO erp_proc_execute_finite_v1;
GRANT SELECT, INSERT, UPDATE ON TABLE procurement.supplier_bid_lines TO erp_proc_execute_finite_v1;
GRANT UPDATE ON TABLE procurement.sourcing_invitations TO erp_proc_execute_finite_v1;
DO $m7_quotation_ownership$
DECLARE t text;
BEGIN
  FOREACH t IN ARRAY ARRAY['procurement.sourcing_manual_contacts','procurement.sourcing_manual_quote_versions'] LOOP
    IF pg_catalog.has_any_column_privilege('erp_proc_execute_finite_v1',t,'UPDATE')
      OR pg_catalog.has_any_column_privilege('erp_proc_execute_finite_v1',t,'REFERENCES')
      OR pg_catalog.has_table_privilege('erp_proc_execute_finite_v1',t,'DELETE,TRUNCATE,TRIGGER') THEN
      RAISE EXCEPTION 'Quotation evidence must remain append-only' USING ERRCODE='55000';
    END IF;
  END LOOP;
  IF pg_catalog.has_any_column_privilege('erp_proc_execute_finite_v1','procurement.finance_payment_status_refs','INSERT')
    OR pg_catalog.has_any_column_privilege('erp_proc_execute_finite_v1','procurement.finance_payment_status_refs','UPDATE')
    OR pg_catalog.has_any_column_privilege('erp_proc_execute_finite_v1','procurement.finance_payment_status_refs','REFERENCES')
    OR pg_catalog.has_table_privilege('erp_proc_execute_finite_v1','procurement.finance_payment_status_refs','DELETE,TRUNCATE,TRIGGER,REFERENCES') THEN
    RAISE EXCEPTION 'Quotation capture must not write Finance settlement facts' USING ERRCODE='55000';
  END IF;
END
$m7_quotation_ownership$;
COMMIT;
